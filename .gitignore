# 比赛数据（20G，公开发布包，不入库）
/data/

# 虚拟环境 / Python 缓存
/.venv/
__pycache__/
*.py[cod]

# 编辑器 / 日志 / 系统
nvim.log
.DS_Store
*.swp

# 大体积生成产物（outputs/experiments/ 下的小结仍入库）
/outputs/*.csv
/outputs/*.zip
/outputs/*.parquet
/outputs/*_submission_*/

# 模型产物：小的（json/npz）入库以便复现公榜分数
# 等上了 LightGBM/NN 再改成只记 hash
strategies/**/model/*.txt
strategies/**/model/*.pt
strategies/**/model/*.bin

# CodeGraph 本地索引
/.codegraph/
