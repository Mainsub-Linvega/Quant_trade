# 比赛数据（20G，公开发布包，不入库）
/data/

# 虚拟环境 / Python 缓存
/.venv/
__pycache__/
*.py[cod]

# 编辑器 / 日志 / 系统
nvim.log
.DS_Store
*.swp

# 大体积生成产物（outputs/experiments/ 下的小结仍入库）
/outputs/*.csv
/outputs/*.zip
/outputs/*.parquet
/outputs/*_submission_*/
# 流式聚合缓存（~1.2G，可由 experiments/mt_lagged.py 重新生成）
/outputs/cache/

# 模型产物：小的（json/npz）入库以便复现公榜分数
# 等上了 LightGBM/NN 再改成只记 hash
# strategies/**/model/*.txt 这个第24行会挡住LGBM模型，故选择注释
strategies/**/model/*.pt
strategies/**/model/*.bin

# 当前最好模型（公榜 0.0026330806）是两个已入库候选的**拼装结果**，9.1 MB 全是重复。
# 目录留在盘上，但不入库 —— 拼装就两条命令（NOTES「当前最好模型是怎么拼出来的」也有）：
#   mkdir -p outputs/candidates/v3_hybrid_r480_phasebal
#   cp outputs/candidates/v3_hybrid_r480/{hybrid_meta.json,lgbm_seed*.txt} \
#      outputs/candidates/v3_hybrid_r480_phasebal/
#   cp outputs/candidates/v1_ridge_phasebal/baseline_model.json \
#      outputs/candidates/v3_hybrid_r480_phasebal/
/outputs/candidates/v3_hybrid_r480_phasebal/

# CodeGraph 本地索引
/.codegraph/

# 08-11：history 列数 80 的候选。公榜实测与 40 列打平（−0.0032%）却慢 0.44 分钟，
# 已结案不采用；数字见 experiments/ledger.csv 与 NOTES.md。9.2MB 不值得入库。
/outputs/candidates/v3_hybrid_r480_phasebal_hist_c80/
# 接线期的冒烟产物（modulo 50 / 1 seed / 20 轮），只为验证代码路径
/outputs/candidates/v3_hybrid_hist_smoke/
/outputs/experiments/history_peak_smoke.json
/outputs/experiments/history_peak_smoke.md

# 可由已入库候选 + promotion/packaging 脚本重建的交付暂存物
/outputs/promotions/**/baseline_model.json
/outputs/promotions/**/hybrid_meta.json
/outputs/promotions/**/*.txt
/outputs/private_submissions/

# 2026-08-24：派生数据根（scripts/build_extended_data_root.py）。
# train/ 里既有指向 4.1 GB 源数据的符号链接，也有一个 1.47 GB 的物理截断分区
# （decision 根的 train_partition_010.parquet）⟹ 一个都不入库。
# ⚠️ 上面那条 `/outputs/*.parquet` 只匹配 outputs/ 直下，管不到这一层。
# root_identity.json 与 manifest.json **要入库** —— 它们记着每个成员的 sha256、
# 训练段边界和行数，是「D1 训练段止于 1,045,889」这条纪律的落盘证据。
/outputs/data_roots/*/train/
/outputs/data_roots/*/test
/outputs/data_roots/*/sample_submission.csv

# ---- 08-13 的六个候选，合计 115 MB，一律不入库 ----
# 这一批用了 train.py 的 --train-only/--reuse-from：只重训被调的那片森林，另一片原样复用
# ⟹ 目录之间大量逐字节重复。分数全部在 experiments/ledger.csv，训练是确定性的
#（deterministic + 固定种子，实测两次独立跑 6 个模型逐字节相同），重建命令见各行注释。
#
# 交付基线本身**已经入库** —— 它就是 strategies/v3_hybrid/model/（08-13 已转正，
# 公榜 0.0039977510）。mkt_shrunk 与它逐字节相同，再存一份纯属重复。
/outputs/candidates/v3_hybrid_mkt_shrunk/
#   重建：train.py --model-dir … --num-iteration 480 --n-seeds 3 --weighted-cross-section
#         --market-model --market-lambda 0.5 --train-only market
#         --reuse-from <r480_pb_hist_mktwe>
#         --market-spec '{"num_leaves":15,"learning_rate":0.02,"feature_fraction":0.4,
#                         "lambda_l2":30.0}' --market-min-data-scale 8.333
#
# 上一版交付基线（公榜 0.0039673997），两片森林都是 SPEC 默认参数。
/outputs/candidates/v3_hybrid_r480_pb_hist_mktwe/
#   重建：同上但去掉 --train-only/--reuse-from/--market-spec/--market-min-data-scale
#
# 以下四个是 ledger 里 rollback 的负结果，只为留证，不值得占仓库体积：
#   mkt_moderate  市场块中档容量        公榜 0.0039867107（+0.49%，不如 shrunk）
#   xs_shrunk     截面块收缩            公榜 0.0035771492（−9.84%，xs_loose 稳固）
#   xs_moderate   截面块中档            未交（xs_shrunk 已定方向）
#   r960          轮数 480→960（39 MB） 公榜 0.0037609312（−5.20%，480 是内部极值）
/outputs/candidates/v3_hybrid_mkt_moderate/
/outputs/candidates/v3_hybrid_xs_shrunk/
/outputs/candidates/v3_hybrid_xs_moderate/
/outputs/candidates/v3_hybrid_r960_pb_hist_mktwe/

# 试水产物（modulo 40 / 2 折 / 60 轮），只为验证代码路径。
# ⚠️ 数字会误导：peer_leadlag_trial 的分量配比给 +3.641%，而生产口径 5 折是 −1.280%。
# 照 history_peak_smoke 的先例不入库。
/outputs/experiments/lgbm_market_row_trial.json
/outputs/experiments/lgbm_market_row_trial.md
/outputs/experiments/peer_leadlag_trial.json
/outputs/experiments/peer_leadlag_trial.md

# Local research smoke outputs and long-running experiment logs
outputs/logs/
outputs/experiments/*_smoke.json
outputs/experiments/*_smoke.md

# 云端（JupyterHub）跑出来的结果：py3.11/numpy1.24 口径，不与本地结果混排
outputs/cloud/

# Claude Code 的个人级项目配置（含仓库级权限规则），不进版本控制
.claude/settings.local.json

# 2026-08-25：B1（种子 3→10）已 REJECTED，20 片森林（43 MB）无后续用途 ——
# 结论证据在 outputs/experiments/b1_search.json 与 ROADMAP §P-B1，
# staging 的 promotion_manifest.json 也记着每片森林的 sha256。
/outputs/candidates/v3_seeds10_original/*.txt
/outputs/candidates/v3_seeds10_original/baseline_model.json
